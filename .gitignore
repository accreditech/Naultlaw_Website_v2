# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference — design handoff docs, kept for reference, not committed
/claude_handoff/*
# SEO audit-and-trim Phase 1: committed for PR review and audit trail
!/claude_handoff/seo_audit_trim/
# SEO audit-and-trim Phase 2: committed for PR review and audit trail
!/claude_handoff/seo_audit_trim_phase_2/

# Claude Code internal session state
/.claude/

# Local debug screenshots
/snapshots/
